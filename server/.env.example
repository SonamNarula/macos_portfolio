# Create a .env file in this server/ directory and add your Google AI Studio API key.
# Never commit the real .env file.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Model is intentionally configurable, with no automatic paid-model fallback.
GEMINI_MODEL=gemini-3.1-flash-lite

# Local frontend origin. Add your deployed portfolio origin when deploying the API.
CLIENT_ORIGIN=http://localhost:5173

PORT=5000
